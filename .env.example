# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# Security & Authentication Secrets
JWT_SECRET=""
JWT_REFRESH_SECRET=""
SESSION_SECRET=""

# Initial Super Admin Bootstrap (Configure securely in your private environment)
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""
ADMIN_GATE_PASSCODE=""

# Database & Storage (PostgreSQL compatible)
DATABASE_URL=""
UPLOAD_LIMIT="10MB"
RATE_LIMIT="100"
CORS_ORIGIN=""

# Email Delivery System (SMTP)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# Meta Graph API & Facebook Page Automation Integration
META_APP_ID=""
META_APP_SECRET=""
META_PAGE_ID=""
META_PAGE_ACCESS_TOKEN=""
META_VERIFY_TOKEN=""
META_API_VERSION="v21.0"
